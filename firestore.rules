rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email == "admin@nexustools.io");
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Tools Collection: Publicly readable, only admin can create/update/delete
    match /tools/{toolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Price Plans Collection: Publicly readable, only admin can write
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection: Users can read their own orders; only admin or Cloud Functions can update payment status
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Licenses Collection: Users can read their own licenses; HWID reset handled via transaction
    match /licenses/{licenseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Users cannot generate or alter license keys directly; Cloud Functions / Admin only
      allow write: if isAdmin();
    }

    // Payments & SMS Audit Records: Admin read only; Cloud Functions write only
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only via Firebase Admin SDK
    }

    match /sms_records/{smsId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only via Cloud Functions
    }

    // Connected Companion Devices
    match /devices/{deviceId} {
      allow read, write: if isAdmin();
    }

    // Site Settings (Payment numbers, telegram URLs, announcements)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Audit Logs: Read-only for Admin, write via Cloud Functions
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
